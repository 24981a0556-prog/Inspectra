# =============================================================
# INSPECTRA Backend — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# ── Database ─────────────────────────────────────────────────
# Must match the credentials in docker-compose.yml
DATABASE_URL=postgresql://inspectra:inspectra_secret@localhost:5432/inspectra

# ── JWT Auth ─────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Storage ──────────────────────────────────────────────────
# STORAGE_BACKEND: "local" (dev) | "s3" (production)
STORAGE_BACKEND=local
# Used when STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=INSPECTRA
APP_VERSION=1.0.0

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AI / OCR Provider ────────────────────────────────────────
# OCR_PROVIDER: "demo" (default) | "gemini" | "openai"
# "demo" uses the built-in Demo OCR Provider (no API key needed).
# For real OCR, set OCR_PROVIDER=gemini and provide GEMINI_API_KEY.
OCR_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Demo Mode ────────────────────────────────────────────────
# When DEMO_MODE=true, the UI labels demo inspections clearly.
# Keep true for SIH prototype demonstration.
DEMO_MODE=true

# ── pgAdmin (docker-compose only) ────────────────────────────
PGADMIN_EMAIL=admin@inspectra.gov.in
PGADMIN_PASSWORD=admin
